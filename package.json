{
  "name": "galaxy-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder --win nsis portable",
    "android:sync": "npm run build && npx cap sync android",
    "android:debug": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "android:release": "npm run android:sync && cd android && gradlew.bat assembleRelease",
    "icons": "node scripts/generate-icons.js && node scripts/sync-android-icons.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor/android": "7.6.10",
    "@capacitor/app": "7.1.2",
    "@capacitor/browser": "7.0.5",
    "@capacitor/core": "7.6.10",
    "@fontsource/inter": "5.2.6",
    "@supabase/supabase-js": "2.57.4",
    "capacitor-secure-storage-plugin": "0.11.0",
    "highlight.js": "11.11.1",
    "lucide-react": "0.544.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "9.1.0",
    "react-router-dom": "6.30.1",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.10",
    "@vitejs/plugin-react": "5.0.4",
    "autoprefixer": "10.4.21",
    "concurrently": "9.2.1",
    "electron": "38.1.2",
    "electron-builder": "26.0.12",
    "png-to-ico": "2.1.8",
    "postcss": "8.5.6",
    "sharp": "0.34.3",
    "tailwindcss": "3.4.17",
    "vite": "6.4.1",
    "vitest": "3.2.4",
    "wait-on": "8.0.4"
  },
  "build": {
    "appId": "com.galaxyai.app",
    "productName": "Galaxy AI",
    "directories": { "output": "release" },
    "files": ["dist/**", "electron/**", "package.json"],
    "win": { "icon": "build/icon.ico", "target": ["nsis", "portable"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
